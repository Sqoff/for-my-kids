<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 바탕 (ADR 77): 모서리 곡선(40dp)과 변이 살짝 들어간 깊이(4dp)를 dp로 고정 →
     위젯을 크게 해도 쿠션 모양 비율이 그대로이고 글자가 테두리 밖으로 밀리지 않음 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 가운데 (네 변 안쪽) -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><solid android:color="@color/widget_bg" /></shape>
    </item>
    <!-- 네 변: 길이만 늘어나고 들어간 깊이는 고정 -->
    <item android:height="4dp" android:gravity="top|fill_horizontal" android:left="40dp" android:right="40dp" android:drawable="@drawable/widget_bg_top" />
    <item android:height="4dp" android:gravity="bottom|fill_horizontal" android:left="40dp" android:right="40dp" android:drawable="@drawable/widget_bg_bottom" />
    <item android:width="4dp" android:gravity="start|fill_vertical" android:top="40dp" android:bottom="40dp" android:drawable="@drawable/widget_bg_left" />
    <item android:width="4dp" android:gravity="end|fill_vertical" android:top="40dp" android:bottom="40dp" android:drawable="@drawable/widget_bg_right" />
    <!-- 네 모서리 -->
    <item android:width="40dp" android:height="40dp" android:gravity="top|start" android:drawable="@drawable/widget_bg_tl" />
    <item android:width="40dp" android:height="40dp" android:gravity="top|end" android:drawable="@drawable/widget_bg_tr" />
    <item android:width="40dp" android:height="40dp" android:gravity="bottom|start" android:drawable="@drawable/widget_bg_bl" />
    <item android:width="40dp" android:height="40dp" android:gravity="bottom|end" android:drawable="@drawable/widget_bg_br" />
</layer-list>
