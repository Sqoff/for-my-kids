<?xml version="1.0" encoding="utf-8"?>
<!-- 부부 상태 위젯 — 넉넉한 크기 (ADR 67, 71): 부드러운 카드 두 장 + 알약 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="우리 지금"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="뽀마키즈"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/row_mom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_card_mom"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/mom_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="엄마"
                    android:textColor="@color/widget_mom"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/mom_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_emoji_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="🚸"
                    android:textSize="16sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/mom_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="등원 중"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/mom_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="08:40부터"
                android:textColor="@color/widget_sub"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row_dad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_dad"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/dad_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="아빠"
                    android:textColor="@color/widget_dad"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/dad_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_emoji_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="💼"
                    android:textSize="16sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/dad_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="일하는 중"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/dad_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="09:02부터"
                android:textColor="@color/widget_sub"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/loc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_btn"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_change"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="상태 바꾸기"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_solid"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="📍 위치 물어보기"
            android:textColor="@color/widget_on_solid"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
