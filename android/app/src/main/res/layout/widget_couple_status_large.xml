<?xml version="1.0" encoding="utf-8"?>
<!-- 부부 상태 위젯 — 넉넉한 크기 (ADR 67): 두 사람 카드를 나란히 크게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="우리 지금"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="뽀마키즈"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/row_mom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_card_mom"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/mom_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="엄마"
                android:textColor="@color/widget_mom"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/mom_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🚸 등원 중"
                android:textColor="@color/widget_ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />
            <TextView
                android:id="@+id/mom_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="08:40부터"
                android:textColor="@color/widget_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_dad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_dad"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/dad_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="아빠"
                android:textColor="@color/widget_dad"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/dad_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="💼 일하는 중"
                android:textColor="@color/widget_ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />
            <TextView
                android:id="@+id/dad_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="09:02부터"
                android:textColor="@color/widget_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_change"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="상태 바꾸기"
            android:textColor="@color/widget_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_solid"
            android:gravity="center"
            android:text="앱 열기"
            android:textColor="@color/widget_on_solid"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
