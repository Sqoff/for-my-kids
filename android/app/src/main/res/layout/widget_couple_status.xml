<?xml version="1.0" encoding="utf-8"?>
<!-- 부부 상태 위젯 — 낮게 놓였을 때 (ADR 74): 같은 디자인, 핀과 카드를 옆으로 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_ic_header_map" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="지금, 우리 가족은"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            android:id="@+id/loc_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:id="@+id/loc_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_ic_broadcast" />
            <TextView
                android:id="@+id/loc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="위치 비공개"
                android:textColor="@color/widget_neutral_ink"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_map" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
        <LinearLayout
            android:id="@+id/row_mom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="46dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_pin_mom" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_card"
                android:gravity="center"
                android:minWidth="72dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/mom_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="엄마"
                        android:textColor="@color/widget_mom"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/mom_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="🏠"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mom_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="쉬는 중"
                    android:textColor="@color/widget_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:maxWidth="84dp"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/mom_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_sub"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:maxWidth="84dp"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row_dad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="46dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_pin_dad" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_card"
                android:gravity="center"
                android:minWidth="72dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dad_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아빠"
                        android:textColor="@color/widget_dad"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/dad_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="💼"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/dad_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="일하는 중"
                    android:textColor="@color/widget_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:maxWidth="84dp"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/dad_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_sub"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:maxWidth="84dp"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_btn_gray"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btn_open_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_pin" />
            <TextView
                android:id="@+id/btn_open_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="위치 물어보기"
                android:textColor="@color/widget_gray_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_change"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_lav"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_sliders" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="상태 바꾸기"
                android:textColor="@color/widget_lav_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
