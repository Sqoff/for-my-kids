<?xml version="1.0" encoding="utf-8"?>
<!-- 부부 상태 위젯 — 낮게 놓였을 때 (ADR 70, 71): 큰 모양과 같은 디자인을 촘촘하게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="우리 지금"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="뽀마키즈"
            android:textColor="@color/widget_sub"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/row_mom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_card_mom"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/mom_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="엄마"
                    android:textColor="@color/widget_mom"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/mom_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_emoji_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="🚸"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/mom_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="등원 중"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/mom_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="08:40부터"
                android:textColor="@color/widget_sub"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row_dad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_dad"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/dad_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="아빠"
                    android:textColor="@color/widget_dad"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/dad_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_emoji_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="💼"
                    android:textSize="13sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/dad_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="일하는 중"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/dad_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="09:02부터"
                android:textColor="@color/widget_sub"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/loc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_btn"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_change"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="상태 바꾸기"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_solid"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="📍 위치 물어보기"
            android:textColor="@color/widget_on_solid"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
